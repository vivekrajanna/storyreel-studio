# StoryReel Studio — Bring Your Own Key (BYOK) Configuration
# Copy this file to `.env` and add your own API key. NEVER commit `.env`.

# 1. Gemini API Key (Required for AI image, TTS, translation, and SEO generation)
# Works with BOTH:
#   - Standard Google AI Studio key (starts with "AIza...") -> https://aistudio.google.com/apikey
#   - Google Cloud Vertex AI Express Mode key (starts with "AQ....")
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Force provider endpoint ("auto" detects AIza -> aistudio, AQ. -> vertex)
# Values: auto | aistudio | vertex
GEMINI_PROVIDER=auto

# Optional: Default provider backend ("gemini" or "mock" for 100% offline dry-runs)
STORYREEL_PROVIDER=gemini

# 2. Optional: YouTube Analytics & Channel Sync (only needed for the Analytics tab)
# Place your Google Cloud OAuth Desktop client file at `client_secret.json` (gitignored)
# or provide a YouTube Data API v3 key for public stats only:
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_HANDLE=@YourChannel
